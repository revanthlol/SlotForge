@startuml SlotForge-V2-Sequence-Diagram
title SlotForge — Simple Sequence Diagram

skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #475569
skinparam ParticipantBorderColor #334155
skinparam ParticipantBackgroundColor #F8FAFC

actor Admin

participant "React Frontend" as Frontend
participant "FastAPI Backend" as Backend
participant "Scheduler" as Scheduler
database PostgreSQL as Database

Admin -> Frontend : Login

Frontend -> Backend : Authenticate

Backend --> Frontend : Session Token

Admin -> Frontend : Generate Timetable

Frontend -> Backend : Generate Request

Backend -> Database : Load Academic Data

Database --> Backend : Teachers,\nSubjects,\nRooms,\nConstraints

Backend -> Scheduler : Generate Timetable()

Scheduler --> Backend : Timetable / Conflicts

Backend -> Database : Save Timetable

Database --> Backend : Success

Backend --> Frontend : Timetable Result

Frontend --> Admin : Display Timetable

note right of Scheduler
  Applies scheduling rules
  and validates constraints
  before returning the result.
end note

@enduml