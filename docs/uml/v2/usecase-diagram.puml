@startuml SlotForge-V2-UseCase-Diagram
title SlotForge — Simple Use Case Diagram

left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam ArrowColor #475569
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
}

actor "Admin" as Admin
actor "Faculty" as Faculty

rectangle "SlotForge System" {

usecase "Login" as UC1
usecase "Manage Workspace" as UC2

usecase "Manage Teachers" as UC3
usecase "Manage Subjects" as UC4
usecase "Manage Sections" as UC5
usecase "Manage Rooms" as UC6
usecase "Manage Time Slots" as UC7
usecase "Manage Constraints" as UC8

usecase "Generate Timetable" as UC9
usecase "View Timetable" as UC10
usecase "Publish Timetable" as UC11
usecase "Rollback Version" as UC12
usecase "Export Timetable" as UC13

}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC9
Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13

Faculty --> UC1
Faculty --> UC10

note right of UC9
  Generates a timetable while
  respecting teacher availability,
  room capacity, subject hours,
  and scheduling constraints.
end note

@enduml