@startuml SlotForge-Deployment-Diagram
title SlotForge — Deployment Diagram
skinparam shadowing false
skinparam linetype ortho
skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #334155
}
skinparam component {
  BackgroundColor #EEF2FF
  BorderColor #4338CA
}
skinparam database {
  BackgroundColor #ECFDF5
  BorderColor #047857
}
skinparam cloud {
  BackgroundColor #FFF7ED
  BorderColor #C2410C
}
skinparam ArrowColor #475569

node "User Device" as browser {
  artifact "Browser" as webbrowser
  note right
    Admin / editor / viewer users.
    Public faculty share pages do not
    require a faculty login.
  end note
}

cloud "Vercel / Static Web Hosting" as vercel {
  component "SlotForge React SPA" as spa
  artifact "Vite build\nTypeScript + React" as frontend
  component "React Flow Canvas" as canvas
  component "Ant Design UI\n+ design tokens" as ui
  spa -- frontend
  spa -- canvas
  spa -- ui
}

node "Oracle Cloud VPS\n(or equivalent backend host)" as backendHost {
  component "FastAPI Application" as api {
    component "REST API routes" as routes
    component "JWT auth + RBAC" as auth
    component "Domain services" as services
    component "Preset registry\n5 domain adapters" as presets
    component "Heatmap + explainability" as explain
    component "Export + faculty share" as delivery
  }
  component "CP-SAT Solver" as solver
  component "SQLAlchemy 2 + Alembic" as orm
  artifact "Generated export files\n(static/exports)" as exportFiles
  api --> routes
  api --> auth
  api --> services
  services --> presets
  services --> explain
  services --> delivery
  services --> solver
  services --> orm
  delivery --> exportFiles
}

cloud "Supabase" as supabase {
  database "Managed PostgreSQL" as postgres
  component "Supabase Auth\nJWT + JWKS" as supaAuth
  component "Supabase Storage\n(optional artifacts)" as storage
  postgres -- supaAuth : organization/user identity
}

cloud "External providers" as external {
  component "Google Drive API" as google
  component "Public share consumer" as publicConsumer
}

database "Redis 7\n(optional / deferred)" as redis #FDE68A

webbrowser --> vercel : HTTPS
webbrowser --> backendHost : REST / JSON
spa --> backendHost : API calls + bearer JWT
spa --> supabase : Auth session
backendHost --> supabase : SQL/TLS + JWKS verification
orm --> postgres : SQLAlchemy
auth --> supaAuth : verify JWT keys
delivery --> storage : optional file storage
delivery --> google : Google Docs export
publicConsumer --> backendHost : tokenized share URL
backendHost ..> redis : future async jobs / caching

note bottom of backendHost
  Current implementation solves synchronously; the roadmap explicitly
  defers Redis/RQ production scaling. The repository includes a Docker
  Compose Redis service, but it is not a required runtime dependency.
end note

note bottom of supabase
  Database contains the multi-tenant schema modeled in er-diagram.puml:
  organizations, workspaces, generic resources/tasks/groups/locations,
  timeslots, constraints, runs, versions, assignments, onboarding,
  audit, and faculty share links.
end note

note bottom of vercel
  Frontend feature areas include onboarding, timetable CRUD/generation,
  heatmap, constraint playground, version control, faculty view,
  exports, settings/team, and the React Flow canvas map.
end note
@enduml
